# Optional. Without a server key, each person adds their own key in the app's
# Options. Set one here to host Alligator for people without their own key.
# Get it from https://console.soniox.com. It needs the "Temporary API keys" and
# "Speech-to-text, real-time" permissions (or Full access).
SONIOX_API_KEY=
PORT=5173
# Optional. A folder where every session's transcript is kept up to date while
# it runs, as spoken and in TRANSCRIPT_LANG (default: en).
TRANSCRIPT_DIR=
TRANSCRIPT_LANG=en
